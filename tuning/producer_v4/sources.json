{
  "schema": "producer-v4-sources-v1",
  "written": "2026-11-08, before any row was built (docs/loop/PRODUCER_TRAINING_PLAN.md section 3)",
  "licences_read_from": "each source's own card or LICENSE file on 2026-11-08",
  "sources": {
    "gov_report": {"use": "train", "family": "government research reports", "benchmark_family": null,
                   "licence": "CC BY 4.0", "card": "https://huggingface.co/datasets/launch/gov_report",
                   "fetch": {"kind": "rows", "dataset": "launch/gov_report", "config": "plain_text", "split": "train",
                             "offset": 0, "count": 60, "text": ["document"], "id": "id"},
                   "rows": 140},
    "billsum": {"use": "train", "family": "legislation", "benchmark_family": null,
                "licence": "CC0 1.0 (US bills from GovInfo; the card states no licence for the California bills, which are not used: ca_test is never fetched)",
                "card": "https://huggingface.co/datasets/FiscalNote/billsum",
                "fetch": {"kind": "rows", "dataset": "FiscalNote/billsum", "config": "default", "split": "train",
                          "offset": 0, "count": 100, "text": ["text"], "id": null},
                "rows": 100},
    "qasper": {"use": "train", "family": "scientific papers", "benchmark_family": "SciTab",
               "licence": "CC BY 4.0", "card": "https://huggingface.co/datasets/allenai/qasper",
               "fetch": {"kind": "rows", "dataset": "allenai/qasper", "config": "qasper", "split": "train",
                         "offset": 0, "count": 30, "text": ["full_text.paragraphs"], "id": "id"},
               "rows": 40},
    "tat_qa": {"use": "train", "family": "financial reports", "benchmark_family": "FinDVer",
               "licence": "CC BY 4.0", "card": "https://huggingface.co/datasets/next-tat/TAT-QA",
               "fetch": {"kind": "file", "url": "https://huggingface.co/datasets/next-tat/TAT-QA/resolve/main/tatqa_dataset_train.json",
                         "text": ["paragraphs.text"], "id": "table.uid"},
               "rows": 40},
    "finqa": {"use": "train", "family": "financial reports", "benchmark_family": "FinDVer",
              "licence": "MIT (the repository's LICENSE, copyright 2021 Zhiyu Chen)", "card": "https://github.com/czyssrs/FinQA",
              "fetch": {"kind": "file", "url": "https://raw.githubusercontent.com/czyssrs/FinQA/main/dataset/train.json",
                        "text": ["pre_text", "post_text"], "id": "id"},
              "rows": 20},
    "pubmed_qa": {"use": "fresh_held_out", "family": "biomedical abstracts", "benchmark_family": null,
                  "licence": "MIT (the dataset card; the abstracts come from PubMed)", "card": "https://huggingface.co/datasets/qiaojin/PubMedQA",
                  "fetch": {"kind": "rows", "dataset": "qiaojin/PubMedQA", "config": "pqa_unlabeled", "split": "train",
                            "offset": 0, "count": 100, "text": ["context.contexts"], "id": "pubid"},
                  "rows": 50}
  },
  "fresh_in_family": {"rows": 50, "rule": "spans from documents of the five training sources that no training row uses (documents fetched past the training documents, by the same fetch with a later offset)",
                      "offsets": {"gov_report": 60, "billsum": 100, "qasper": 30}},
  "excluded": ["any share-alike source (Wikipedia text and tables, TabFact's tables, FEVER), D-281",
               "CUAD, ContractNLI, SciTab, ContraDoc and FinDVer in any split",
               "every development item of the plan's section 4 and everything sealed"]
}
