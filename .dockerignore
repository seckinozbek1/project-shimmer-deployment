# Build-context excludes, matching the Dockerfile's own explicit COPY list.
# COPY only ever names scripts/, config/, tools/, corpus_ingest/, the three
# root markdown files, VERSION and a few named files under tuning/, benchmark/fixtures/
# and docs/, so most of these are belt-and-suspenders rather than
# load-bearing; .git and any venv are the ones that would otherwise bloat the
# build context significantly.
.git/
.claude/
benchmark/keys/
.venv/
venv/
__pycache__/
*.pyc
Dockerfile
.dockerignore

# Never shipped in the image at this stage: runtime-only directories this
# working copy happens to have locally (durable/, input/, output/), and the
# public snapshot's own audit trail.
durable/
input/
output/
docs/publish/

# Third-party benchmark data, raw or converted, and its manifests (loop S4b).
# Never committed; only adapters, the selection, the preregistration and
# synthetic gate fixtures are tracked.
/external/
# Seal manifests of sealed tests (Annex B.3), at any depth as .gitignore's `seals/`
# and scripts/guard_secrets.py --staged refuse them; never in a build context.
**/seals/
# Generated development suite and long-range corpus: exposed by construction, regenerated from committed seeds.
/benchmark/dev_suite/generated/
/benchmark/long_range/generated/
