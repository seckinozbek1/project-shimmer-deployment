# A shell script executed inside the Linux container must keep LF line endings on
# every checkout: with Windows autocrlf, tools/entrypoint.sh came out CRLF, the
# image's exec of "#!/bin/sh\r" failed with "no such file or directory", and the
# rebuilt container could not start (found at the first offline test, 2026-09-11).
*.sh text eol=lf
tools/entrypoint.sh text eol=lf

# Preserve the exact bytes of the reviewed V2 freeze and its bound reports.
tuning/second_domain_agnostic_v2/** -text
docs/fix/SECOND_TUNING_DATA_AND_FAILURE_AUDIT.md -text
docs/fix/SECOND_TUNING_EXPERIMENT_IMPLEMENTATION.md -text
docs/fix/second_tuning_canonical_pilot/** -text
tuning/second_tuning_eval_runtime_v2/** -text
docs/fix/PRODUCER_DEV_GENERATION_PATH_AUDIT.md -text
docs/fix/EVALUATION_RUNTIME_V2_IMPLEMENTATION.md -text
