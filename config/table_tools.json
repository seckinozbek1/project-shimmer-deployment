            "columns": {
              "c1": "Item",
              "c2": "X",
              "c3": "Y"
            },
            "rows": 3,
            "figures": {
              "f1": "12.5",
              "f2": "15%"
            }
          },
          "args": [
            "r1c2",
            "r2c1"
          ],
          "expected": "r1c2 = 12.5; r2c1 = B"
        }
