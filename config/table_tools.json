        "cell_claim"
      ],
      "applies_when": {
        "min_cells_left_out": 1
      },
      "examples": [
        {
          "context": {
            "cells": {
              "r1c1": "A",
              "r1c2": "12.5",
              "r1c3": "40%",
              "r2c1": "B",
              "r2c2": "10",
              "r2c3": "25%",
              "r3c1": "C",
              "r3c2": "0",
              "r3c3": "25%"
